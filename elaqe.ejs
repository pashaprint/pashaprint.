<!-- Contact Page -->
<section class="section">
  <h2 class="section-title">Əlaqə</h2>
  <p class="section-desc">Bizimlə əlaqə saxlayın, sifarişinizi verin.</p>

  <div class="contact-grid">
    <div class="contact-info">
      <div class="contact-card">
        <div class="contact-icon"><i class="fas fa-phone"></i></div>
        <div>
          <h4>Telefon</h4>
          <a href="tel:+994703022305">070 302 23 05</a>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-icon"><i class="fab fa-whatsapp"></i></div>
        <div>
          <h4>WhatsApp</h4>
          <a href="https://wa.me/994703022305" target="_blank">070 302 23 05</a>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-icon"><i class="fab fa-instagram"></i></div>
        <div>
          <h4>Instagram</h4>
          <a href="https://instagram.com/pashaprintt" target="_blank">@pashaprintt</a>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-icon"><i class="fas fa-clock"></i></div>
        <div>
          <h4>İş Saatları</h4>
          <p>Bazar ertəsi - Şənbə: 09:00 - 18:00</p>
        </div>
      </div>
    </div>

    <div class="contact-form-wrapper">
      <h3>Mesaj Göndərin</h3>
      <form class="contact-form" id="contactForm">
        <div class="form-group">
          <label for="name">Ad, Soyad</label>
          <input type="text" id="name" name="name" placeholder="Adınızı daxil edin" required>
        </div>
        <div class="form-group">
          <label for="phone">Telefon</label>
          <input type="tel" id="phone" name="phone" placeholder="070 XXX XX XX" required>
        </div>
        <div class="form-group">
          <label for="subject">Mövzu</label>
          <select id="subject" name="subject" required>
            <option value="">Seçin...</option>
            <option value="polietilen">Polietilen Paket</option>
            <option value="kraft">Kraft Paket</option>
            <option value="lent">Lent Çapı</option>
            <option value="sticker">Sticker / Vizitkart</option>
            <option value="etir">Ətir Qutuları</option>
            <option value="diger">Digər</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Mesaj</label>
          <textarea id="message" name="message" rows="4" placeholder="Mesajınızı yazın..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-full">
          <i class="fab fa-whatsapp"></i> WhatsApp ilə Göndər
        </button>
      </form>
    </div>
  </div>
</section>
